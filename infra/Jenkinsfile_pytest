pipeline {
  agent any // будем задавать агента на каждом этапе

  environment {
    // подтянет из Jenkins Credentials (Secret text) ваш токен SonarCloud
    SONAR_TOKEN = credentials('SONAR_TOKEN')
  }

  stages {
    stage('Checkout') {
      agent {
        docker {
          image 'python:3.9'
          args  '--user root:root'
        }
      }
      steps {
        git url: 'https://github.com/denisdugar/ci-cd-tutorial-sample-app.git', branch: 'master'
      }
    }

    stage('Validate Commit') {
      agent any
      steps {
        script {
          def lastMsg = ''
          for (changeSet in currentBuild.changeSets) {
            for (entry in changeSet.items) {
              lastMsg = entry.msg
            }
          }
          if (lastMsg?.trim() == 'build: automatic update of app') {
            error("depricated commit: ${lastMsg}")
          }
        }
      }
    }

    stage('Install & Test with Coverage') {
      agent {
        docker {
          image 'python:3.9'
          args  '--user root:root'
        }
      }
      steps {
        sh 'pip install -r requirements.txt'
        // установим coverage
        sh 'pip install coverage'
        // запускаем тесты под coverage и генерим XML
        sh '''
          coverage run -m unittest discover
          coverage xml -o coverage.xml
        '''
        // для отладки: покажем кратко %
        sh 'coverage report'
      }
      // сохраняем артефакт отчёта, чтобы был доступен на Jenkins
      post {
        always {
          archiveArtifacts artifacts: 'coverage.xml', fingerprint: true
        }
      }
    }

    stage('SonarCloud Analysis') {
      // используем готовый CLI-контейнер с sonar-scanner
      agent any
      steps {
        script {
          def scannerHome = tool 'SonarScanner'
          withSonarQubeEnv('SonarCloud') {
            sh 'mkdir -p /tmp/sonar-scanner-work'
            
            sh """
              ${scannerHome}/bin/sonar-scanner \
                -Dsonar.projectKey=denisdugar_ci-cd-tutorial-sample-app \
                -Dsonar.organization=denisdugar \
                -Dsonar.sources=. \
                -Dsonar.host.url=https://sonarcloud.io \
                -Dsonar.login=${SONAR_TOKEN} \
                -Dsonar.javascript.lcov.reportPaths=coverage/lcov.info \
                -Dsonar.working.directory=/tmp/sonar-scanner-work
            """
          }
        }
      }
    }

    stage('Quality Gate') {
      steps {
        // ждём результат Quality Gate из SonarCloud
        timeout(time: 5, unit: 'MINUTES') {
          waitForQualityGate(abortPipeline: true)
        }
      }
    }
  }
}
